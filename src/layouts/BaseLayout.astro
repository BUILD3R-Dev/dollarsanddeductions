---
import { SITE, NAV, EDU_DISCLAIMER } from '../data/site';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  ogType?: string;
}

const { title, description, canonical, noindex, schema, ogType = 'article' } = Astro.props;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, SITE.url).toString();
const path = Astro.url.pathname;
const isCurrent = (href: string) => href === '/' ? path === href : (href.endsWith('/') ? path === href : path.startsWith(href));
const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];

---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE.name} />
    <meta name="twitter:card" content="summary" />
    <!-- GA4: Measurement ID goes here when Dustin creates the data stream -->
    <link rel="icon" type="image/svg+xml" href="/brand/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400..700;1,6..72,400..500&family=Public+Sans:ital,wght@0,400..700;1,400&display=swap" rel="stylesheet" />
    {schemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site">
      <div class="container nav">
        <a class="brand" href="/">
          <picture>
            <source media="(min-width: 1100px)" srcset="/brand/horizontal-tagline-light.svg" width="393" height="62" />
            <img class="brand-logo brand-logo-header" src="/brand/horizontal-light.svg" alt="Dollars &amp; Deductions" width="319" height="44" />
          </picture>
        </a>
        <nav class="links" aria-label="Primary">
          {NAV.map((n) => <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site">
      <div class="container foot-grid">
        <div class="foot-brand">
          <a class="brand" href="/">
            <img class="brand-logo brand-logo-tagline" src="/brand/horizontal-tagline-dark.svg" alt="Dollars &amp; Deductions — plain-English tax guides for real business owners" width="507" height="80" />
          </a>
        </div>
        <nav aria-label="Footer">
          <a href="/about/">About</a>
          <a href="/how-we-research/">How we research</a>
          <a href="/disclosure/">Disclosure</a>
          <a href="/privacy/">Privacy</a>
          <a href="/sitemap-index.xml">Sitemap</a>
        </nav>
        <div class="foot-text">
          <p>{EDU_DISCLAIMER}</p>
          <p>We may earn a referral fee when you connect with a service provider through links on this site. <a href="/disclosure/">Read our disclosure</a>.</p>
          <p>© 2026 dollarsanddeductions.com</p>
        </div>
      </div>
    </footer>
    <script>
      // Checklists become tickable; progress is remembered per page in this browser.
      document.querySelectorAll<HTMLUListElement>('ul.checklist').forEach((list, li) => {
        const key = `dd-check:${location.pathname}:${li}`;
        let saved: number[] = [];
        try { saved = JSON.parse(localStorage.getItem(key) ?? '[]'); } catch {}
        const items = [...list.children] as HTMLLIElement[];
        const save = () => {
          const done = items.flatMap((item, i) => (item.querySelector('input')?.checked ? [i] : []));
          try { localStorage.setItem(key, JSON.stringify(done)); } catch {}
        };
        list.classList.add('is-interactive');
        items.forEach((item, i) => {
          const label = document.createElement('label');
          const box = document.createElement('input');
          box.type = 'checkbox';
          box.checked = saved.includes(i);
          box.addEventListener('change', save);
          const text = document.createElement('span');
          text.append(...item.childNodes);
          label.append(box, text);
          item.append(label);
        });
      });
    </script>
  </body>
</html>
