---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadCTA from '../components/LeadCTA.astro';
import DisclosureBlock from '../components/DisclosureBlock.astro';
import FAQ, { type FaqItem } from '../components/FAQ.astro';
import Worksheet from '../components/Worksheet.astro';
import { GUIDES, HUBS } from '../data/guides';
import { SITE } from '../data/site';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  description: SITE.tagline,
};

const faqs: FaqItem[] = [
  {
    q: 'Is this site run by accountants?',
    a: 'No. Dollars & Deductions is an independent educational publication. We are not CPAs, tax advisors, or attorneys, and nothing here is personalized tax, legal, or financial advice. When a topic needs a professional, we say so — and our partner links connect you with licensed firms.',
  },
  {
    q: 'How does this site make money?',
    a: 'Through partner referral fees. When you use a link on this site to connect with a tax firm, formation service, or software provider, we may earn a fee from that provider. It never changes what we write, and every monetized link is labeled.',
  },
  {
    q: 'Is the tax information current?',
    a: 'Guides are reviewed at least monthly against current IRS guidance, and each page shows its review date. Tax law changes, so verify anything consequential against current IRS publications or with a qualified professional before acting.',
  },
];

const HUB_INTRO: Record<(typeof HUBS)[number], { heading: string; body: string }> = {
  'Entity structure': { heading: 'Choosing how your business is taxed', body: 'LLC, S corp, and what the election really changes.' },
  'Tax pros': { heading: 'Hiring help, and what it costs', body: 'What CPAs and strategists do, and how they price it.' },
  Deductions: { heading: 'Lowering what you owe', body: 'The deductions that matter and the records that back them up.' },
};
const shortTitle = (t: string) => t.replace(/ \(2026.*$/, '');
---

<BaseLayout
  title="Dollars & Deductions — Plain-English Small Business Tax Guides"
  description="Plain-English guides to small-business taxes, S corp vs LLC, deductions, CPA costs, bookkeeping, and payroll. Educational content for owners, not accountants."
  ogType="website"
  schema={schema}
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1>Small-business taxes, explained like a human.</h1>
        <p class="hero-sub">S corp vs LLC, deductions, and what a CPA actually costs. Plain-English guides for owners, checked against current IRS guidance.</p>
        <div class="hero-actions">
          <a class="btn btn-lg" href="/s-corp-vs-llc/">Read S corp vs LLC</a>
          <a class="btn btn-quiet btn-lg" href="#guides">Browse all guides</a>
        </div>
        <ul class="hero-proof">
          <li>Built on IRS publications and instructions</li>
          <li>Reviewed monthly, dated on every page</li>
          <li>Independent, with every partner link labeled</li>
        </ul>
      </div>
      <Worksheet />
    </div>
  </section>

  <section class="guides" id="guides" aria-labelledby="guides-title">
    <div class="container">
      <h2 id="guides-title" class="section-title">Find the guide for your question</h2>
      <div class="hubs">
        {HUBS.map((hub) => (
          <div class="hub">
            <div class="hub-intro">
              <h3>{HUB_INTRO[hub].heading}</h3>
              <p>{HUB_INTRO[hub].body}</p>
            </div>
            <ul class="guide-list">
              {GUIDES.filter((g) => g.hub === hub).map((g) => (
                <li>
                  <a href={`/${g.slug}/`}>
                    <strong>{shortTitle(g.title)}</strong>
                    <span class="gl-hook">{g.hook}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="principles" aria-labelledby="principles-title">
    <div class="container">
      <h2 id="principles-title" class="section-title">How these guides are written</h2>
      <div class="principle-grid">
        <div>
          <h3>Primary sources</h3>
          <p>Every guide starts with IRS publications, forms, and instructions — not blog posts quoting blog posts.</p>
        </div>
        <div>
          <h3>No credential cosplay</h3>
          <p>We're not CPAs and don't pretend to be. When a decision needs a professional, we say so.</p>
        </div>
        <div>
          <h3>Money, disclosed</h3>
          <p>Partner referral fees are labeled on every monetized link and never change what we write. <a href="/disclosure/">Read the disclosure</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <div class="container home-tail">
    <LeadCTA kind="accountant" />
    <FAQ items={faqs} />
    <DisclosureBlock />
  </div>
</BaseLayout>
