---
interface Props { items: { label: string; href?: string }[] }
const { items } = Astro.props;
---

<nav class="crumbs" aria-label="Breadcrumb">
  {items.map((item, i) => (
    <span>
      {i > 0 && ' › '}
      {item.href ? <a href={item.href}>{item.label}</a> : <span>{item.label}</span>}
    </span>
  ))}
</nav>
